{
  "video_id": "K-irgyUFdOE",
  "title": "DEL-Cares | Domestic Departures at Delhi Airport",
  "source": "https://www.newdelhiairport.in/passenger-educational-videos/",
  "start": 102,
  "end": 174,
  "cues": [
    {"id": 101, "start": 102.5, "end": 107.5, "english": "I'm sure you've already done a web check-in for your flight.",
     "glosses": [["YOU", "You"], ["FLIGHT", "Aeroplane"], ["INTERNET", "internet"], ["CHECK", "Assess_Check_Investigate"], ["ALREADY", "already"], ["FINISH", "finish"]]},
    {"id": 102, "start": 107.5, "end": 110.0, "english": "Missed web check-in? Don't worry.",
     "glosses": [["INTERNET", "internet"], ["CHECK", "Assess_Check_Investigate"], ["FORGET", "Forget"], ["AFRAID", "Afraid"], ["NO", "no"]]},
    {"id": 103, "start": 110.0, "end": 115.0, "english": "You can use conveniently located self-service kiosks at all three terminals.",
     "glosses": [["ALL", "All"], ["AIRPORT", "airport"], ["SELF", "Self"], ["SERVICE", "Services"], ["COMPUTER", "computer"], ["THERE", "There"], ["YOU", "You"], ["CAN", "Can"]]},
    {"id": 104, "start": 115.0, "end": 126.5, "english": "For Indian passengers with DigiYatra, go ahead and just skip the queues using dedicated e-gates at terminal entry, security, and boarding.",
     "glosses": [["INDIA", "India"], ["PERSON", "Person"], ["DIGIYATRA", null], ["HAVE", "Have"], ["LINE", "Line"], ["WAIT", "wait"], ["NO", "no"], ["SPECIAL", "Special"], ["DOOR", "Door"], ["ENTER", "Enter"], ["SAFE", "safe"], ["CHECK", "Assess_Check_Investigate"], ["FLIGHT", "Aeroplane"], ["ENTER", "Enter"]]},
    {"id": 105, "start": 126.5, "end": 128.0, "english": "Wow, isn't that amazing?",
     "glosses": [["GOOD", "Good"], ["SURPRISED", "surprised"]]},
    {"id": 106, "start": 128.0, "end": 135.0, "english": "Once inside the terminal, make your way to your airline counter to check in your bag and get your boarding pass printed.",
     "glosses": [["AIRPORT", "airport"], ["ENTER", "Enter"], ["FLIGHT", "Aeroplane"], ["COMPANY", "Company"], ["TABLE", "Table"], ["GO", "go"], ["BAG", "Bag"], ["GIVE", "give"], ["PASS", "Pass_(Ticket)"], ["GET", "Get"]]},
    {"id": 107, "start": 135.0, "end": 140.0, "english": "For an even faster option, use the self baggage drop facility.",
     "glosses": [["FAST", "fast"], ["OPTION", "Alternative_Option"], ["SELF", "Self"], ["BAG", "Bag"], ["DROP", "drop"]]},
    {"id": 108, "start": 140.0, "end": 147.0, "english": "If you already have your boarding pass and are carrying only cabin baggage, you may head directly for the security check.",
     "glosses": [["YOU", "You"], ["PASS", "Pass_(Ticket)"], ["ALREADY", "already"], ["HAVE", "Have"], ["SMALL", "Small"], ["BAG", "Bag"], ["SAFE", "safe"], ["CHECK", "Assess_Check_Investigate"], ["GO", "go"]]},
    {"id": 109, "start": 147.0, "end": 149.0, "english": "Done with the security check?",
     "glosses": [["SAFE", "safe"], ["CHECK", "Assess_Check_Investigate"], ["FINISH", "finish"]]},
    {"id": 110, "start": 149.0, "end": 152.0, "english": "You deserve a break.",
     "glosses": [["YOU", "You"], ["REST", "rest"]]},
    {"id": 111, "start": 152.0, "end": 157.0, "english": "Enjoy the shopping and dining options at Delhi airport or relax at the lounge.",
     "glosses": [["DELHI", "Delhi"], ["AIRPORT", "airport"], ["SHOP", "shop"], ["EAT", "eat"], ["HAPPY", "Happy"], ["SIT", "Sit"], ["REST", "rest"]]},
    {"id": 112, "start": 157.0, "end": 160.0, "english": "Be sure to have adequate time before boarding.",
     "glosses": [["FLIGHT", "Aeroplane"], ["ENTER", "Enter"], ["BEFORE", "Before"], ["TIME", "time"], ["HAVE", "Have"]]},
    {"id": 113, "start": 160.0, "end": 163.0, "english": "Time to go. Kindly proceed to your boarding gate.",
     "glosses": [["TIME", "time"], ["GO", "go"], ["PLEASE", "Please"], ["YOUR", "Your"], ["FLIGHT", "Aeroplane"], ["DOOR", "Door"], ["GO", "go"]]},
    {"id": 114, "start": 163.0, "end": 167.0, "english": "Always remember to cross-check your boarding gate number with the screens.",
     "glosses": [["ALWAYS", "always"], ["YOUR", "Your"], ["FLIGHT", "Aeroplane"], ["DOOR", "Door"], ["SCREEN", "Board_(Panel)"], ["CHECK", "Assess_Check_Investigate"], ["REMEMBER", "remember"]]},
    {"id": 115, "start": 167.0, "end": 170.0, "english": "And just like that, we are done.",
     "glosses": [["WE", "We"], ["FINISH", "finish"]]},
    {"id": 116, "start": 170.0, "end": 173.0, "english": "Simple, wasn't it?",
     "glosses": [["EASY", "easy"]]}
  ]
}
